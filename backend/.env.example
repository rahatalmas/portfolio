# Copy to .env and adjust. Every variable is optional except the database ones.

# Listen address
ADDR=:8080

# MySQL — either a full DSN …
# DB_DSN=portfolio:secret@tcp(127.0.0.1:3306)/portfolio
# … or the individual parts (used when DB_DSN is empty)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=secret
DB_NAME=portfolio

# First admin account, created only when no admin exists yet.
# Leave ADMIN_PASSWORD empty to have one generated and printed in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random string (>= 16 chars) used to sign admin session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Where uploads are stored (served at /uploads/)
UPLOAD_DIR=./uploads

# Built frontend to serve at / (run `npm run build` in ../frontend)
FRONTEND_DIR=../frontend/dist

# Allow browser calls to the API from other origins (comma-separated).
# Not needed when the frontend is served by this server or via the Vite proxy.
# CORS_ORIGINS=http://localhost:5173

# Set to true behind HTTPS so cookies carry the Secure flag
SECURE_COOKIES=false

# Insert demo content when every content table is empty
SEED_DEMO=true
