# Copy to .env and adjust. Every variable is optional.

# Listen address
ADDR=:8080

# Where the data files live: content.json (site content, tracked in git)
# and admin.json (admin account).
DATA_DIR=./data

# First admin account, created only when admin.json has no users yet.
# Leave ADMIN_PASSWORD empty to have one generated and printed in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random string (>= 16 chars) used to sign admin session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Where uploads are stored (served at /uploads/)
UPLOAD_DIR=./uploads

# Built React app served at / (run `npm run build` in ../frontend).
# If the directory has no index.html the server still runs; / redirects to /admin.
FRONTEND_DIR=../frontend/dist

# Extra origins allowed to call the API from a browser (comma-separated).
# Not needed when the site is served from this server. Only set it if you host
# the site somewhere else and build it with VITE_API_BASE.
# CORS_ORIGINS=https://other-host.example

# Set to true behind HTTPS so cookies carry the Secure flag
SECURE_COOKIES=false
